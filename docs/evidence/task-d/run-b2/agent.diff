  +"use client";
  +
  +import { useEffect } from "react";
  +import { useRouter } from "next/navigation";
  +
  +const INTERVAL_MS = 5_000;
  +const MAX_POLLS = 120; // ~10 minutes; the workflow normally finishes in 40-90 s
  +
  +// Re-renders the status page on the server while the quote is still being prepared.
  +export function QuoteStatusRefresh() {
  +  const router = useRouter();
  +
  +  useEffect(() => {
  +    let polls = 0;
  +    const timer = setInterval(() => {
  +      polls++;
  +      if (polls > MAX_POLLS) {
  +        clearInterval(timer);
  +        return;
  +      }
  +      router.refresh();
  +    }, INTERVAL_MS);
  +    return () => clearInterval(timer);
  +  }, [router]);
  +
  +  return null;
  +}

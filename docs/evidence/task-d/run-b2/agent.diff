  +import { createHash, createHmac, timingSafeEqual } from "node:crypto";
  +import { db } from "@/lib/db";
  +
  +// Callbacks from n8n: POST /api/n8n/<event>. The endpoint is public, so only the HMAC signature is trusted.
  +// Contract: .claude/skills/integrating-n8n-webhooks/references/contract.md, section 3.
  +
  +const MAX_BODY_BYTES = 64 * 1024;
  +const WINDOW_SECONDS = 300;
  +
  +type CallbackData = {
  +  jobId: string;
  +  status: "completed" | "failed";
  +  requestIdempotencyKey: string;
  +  result?: { documentUrl?: string };
  +  error?: { code?: string };
  +};
  +
  +type Callback = { version: 1; event: string; data: CallbackData };
  +
  +// The status page renders the link, so accept only absolute http(s) URLs (no javascript: and the like).
  +function documentUrlOf(data: CallbackData) {
  +  const value = data.result?.documentUrl;
  +  if (typeof value !== "string" || value.length > 2048) return null;
  +  try {
  +    const url = new URL(value);
  +    return url.protocol === "https:" || url.protocol === "http:" ? url.toString() : null;
  +  } catch {
  +    return null;
  +  }
  +}
  +
  +// One handler per event: "invalid" -> 400, "not-found" -> 404, "ok" -> the state is saved.
  +const HANDLERS: Record<string, (data: CallbackData) => Promise<"ok" | "invalid" | "not-found">> = {
  +  "quote-request": async (data) => {
  +    const documentUrl = data.status === "completed" ? documentUrlOf(data) : null;
  +    if (data.status === "completed" && !documentUrl) return "invalid";
  +    const quote = await db.getQuoteByRequestKey(data.requestIdempotencyKey);
  +    if (!quote) return "not-found";
  +    await db.updateQuote(
  +      quote.id,
  +      data.status === "completed" ? { status: "ready", documentUrl } : { status: "failed" },
  +    );
  +    return "ok";
  +  },
  +};
  +
  +const reply = (status: number, body: Record<string, unknown> = {}) => Response.json(body, { status });
  +
  +export async function POST(request: Request, ctx: RouteContext<"/api/n8n/[event]">) {
  +  const started = Date.now();

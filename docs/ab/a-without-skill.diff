  +"use server";
  +
  +import { after } from "next/server";
  +import { redirect } from "next/navigation";
  +import { db } from "@/lib/db";
  +import { parseQuoteForm, type QuoteFormField } from "@/lib/quote-form";
  +import { createCallbackToken, startQuoteWorkflow } from "@/lib/quotes";
  +
  +const PUBLIC_FORM_WORKSPACE_ID = "ws_studio_nova";
  +
  +export type RequestQuoteState =
  +  | { status: "idle" }
  +  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>> };
  +
  +export async function requestQuote(
  +  _prevState: RequestQuoteState,
  +  formData: FormData,
  +): Promise<RequestQuoteState> {
  +  const parsed = parseQuoteForm(formData);
  +  if (!parsed.ok) {
  +    return { status: "invalid", errors: parsed.errors };
  +  }
  +
  +  const callbackToken = createCallbackToken();
  +  const quote = await db.insertQuote({
  +    ...parsed.data,
  +    workspaceId: PUBLIC_FORM_WORKSPACE_ID,
  +    callbackTokenHash: callbackToken.hash,
  +  });
  +
  +  // The workflow runs 40–90 s, so the action does not wait for it: n8n is triggered after the
  +  // response is sent and reports back to /api/quotes/[id]/callback. `after` also runs on redirect.
  +  after(() => startQuoteWorkflow(quote, callbackToken.token));
  +
  +  redirect(`/quotes/${quote.id}`);
  +}
